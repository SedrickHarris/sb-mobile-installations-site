# Copy to .env.local for local development. Never commit .env.local.

# Production site URL. Used to build canonical URLs, Open Graph URLs, and
# structured-data @id values. See src/data/site/business.ts.
NEXT_PUBLIC_SITE_URL=https://sbmobileinstallations.com

# External forms endpoint. Static export forbids server routes, so both
# CommercialInquiryForm and InstallerNetworkForm POST directly to this
# trusted backend endpoint. If this is absent, malformed, or the endpoint
# request fails, both forms show an accessible inline error and a
# click-to-call fallback instead of a false success state. No secrets, API
# keys, or credentials belong in this file or in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_FORMS_ENDPOINT=
